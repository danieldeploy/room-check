+      'Room name',
+      'Previous code',
+      'Previous code date',
+      'Actual code',
+      'Actual code date',
+      'State date',
+      'Today changed count',
+      'Updated at'
+    ]]);
+}
+
+function ensureHistorySheet_(ss) {
