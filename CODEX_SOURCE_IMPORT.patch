+<body>
+  <main class="app">
+    <section class="card generator-card" aria-labelledby="appTitle">
+      <h1 id="appTitle" class="code-created-line">
+        <span
+          id="generatedCode"
+          aria-live="polite"
+          aria-atomic="true"
+        >
+          ----
+        </span>
+
+        <span class="code-created-separator" aria-hidden="true">-</span>
+        <span class="code-created-title">Code Created</span>
+      </h1>
+
+      <div id="status" role="status" aria-live="polite">
+        Loading room data…
+      </div>
+    </section>
+
+    <section class="card rooms-card" aria-label="Room codes">
+      <div class="room-grid room-header" aria-hidden="true">
+        <div>Room</div>
+        <div>Previous code date</div>
+        <div>Previous code</div>
+        <div>Select</div>
+        <div>Actual code</div>
+        <div>Today changed</div>
+      </div>
+
+      <div id="roomsList"></div>
+    </section>
+  </main>
+
+
+  <div
+    id="appAlert"
+    class="app-alert"
+    role="alertdialog"
+    aria-modal="true"
+    aria-labelledby="appAlertMessage"
+    hidden
+  >
+    <div class="app-alert-box">
+      <div class="app-alert-icon" aria-hidden="true">!</div>
+
+      <div
+        id="appAlertMessage"
+        class="app-alert-message"
+      >
+        The code already used! in the last 30 days!
+      </div>
+
+      <div class="app-alert-secondary">
+        Inform the Airbnb guest a new code!
+      </div>
+
+      <button
+        id="appAlertButton"
+        class="app-alert-button"
+        type="button"
+      >
+        OK
+      </button>
+    </div>
+  </div>
+
+  <textarea id="copyBuffer" aria-hidden="true" tabindex="-1"></textarea>
+
+  <script>
+    let rooms = [];
+    let prepared = null;
+    let selectedRoomId = '';
+    let copiedRoomId = '';
+    let busy = false;
+    let todayKey = '';
+    let todayDisplay = '';
+    const manualInputs = Object.create(null);
+
+    const generatedCode = document.getElementById('generatedCode');
+    const statusElement = document.getElementById('status');
+    const roomsList = document.getElementById('roomsList');
+    const copyBuffer = document.getElementById('copyBuffer');
+    const appAlert = document.getElementById('appAlert');
+    const appAlertMessage =
+      document.getElementById('appAlertMessage');
+    const appAlertButton =
+      document.getElementById('appAlertButton');
+
+    function setStatus(message, type = '') {
+      statusElement.className = type;
+      statusElement.textContent = message;
+    }
+
+    function showAppAlert(message) {
+      appAlertMessage.textContent = message;
+      appAlert.hidden = false;
+      window.setTimeout(function() {
+        appAlertButton.focus();
+      }, 0);
+    }
+
+    function closeAppAlert() {
+      appAlert.hidden = true;
+    }
+
+    appAlertButton.addEventListener('click', closeAppAlert);
+
+    appAlert.addEventListener('click', function(event) {
+      if (event.target === appAlert) {
+        closeAppAlert();
+      }
+    });
+
+    document.addEventListener('keydown', function(event) {
+      if (event.key === 'Escape' && !appAlert.hidden) {
+        closeAppAlert();
+      }
+    });
+
+    function codeText(value) {
+      return value || '—';
+    }
+
+    function dateText(value) {
+      return value || '—';
+    }
+
+    function countText(count) {
+      const number = Number(count) || 0;
+      return number + (number === 1 ? ' Time' : ' Times');
+    }
+
+    function cloneRooms(value) {
+      return JSON.parse(JSON.stringify(value));
+    }
+
+    function selectedRoom() {
+      return rooms.find(function(room) {
+        return room.id === selectedRoomId;
+      }) || null;
+    }
+
+    function mergeRoomState(updatedRoom) {
+      if (!updatedRoom) {
+        return;
+      }
+
+      const index = rooms.findIndex(function(room) {
+        return room.id === updatedRoom.id;
+      });
+
+      if (index !== -1) {
+        const previousActualCode = rooms[index].actualCode;
+        rooms[index] = updatedRoom;
+
+        if (
+          copiedRoomId === updatedRoom.id &&
+          previousActualCode !== updatedRoom.actualCode
+        ) {
+          copiedRoomId = '';
+        }
+      }
+    }
+
+    function isCodeAlreadyUsed(code) {
+      return rooms.some(function(room) {
+        return room.previousCode === code ||
+          room.actualCode === code;
+      });
+    }
+
+    function renderRooms() {
+      roomsList.replaceChildren();
+
+      rooms.forEach(function(room) {
+        const selected = room.id === selectedRoomId;
+        const row = document.createElement('div');
+
+        row.className =
+          'room-grid room-row' +
+          (selected ? ' selected' : '');
+
+        const name = document.createElement('div');
+        name.className = 'room-name';
+        name.textContent = room.name;
+
+        const previousDate = document.createElement('div');
+        previousDate.className =
+          'date-cell' +
+          (!room.previousCodeDateDisplay ? ' empty-date' : '');
+        previousDate.textContent =
+          dateText(room.previousCodeDateDisplay);
+        previousDate.dataset.label = 'Previous code date';
+
+        const previous = document.createElement('div');
+        previous.className =
+          'code-cell previous-code' +
+          (!room.previousCode ? ' empty-code' : '');
+        previous.textContent = codeText(room.previousCode);
+        previous.dataset.label = 'Previous code';
+
+        const controls = document.createElement('div');
+        controls.className = 'selection-controls';
+
+        const radio = document.createElement('input');
+        radio.type = 'radio';
+        radio.name = 'roomSelection';
+        radio.value = room.id;
+        radio.checked = selected;
+        radio.disabled = busy;
+        radio.setAttribute('aria-label', 'Select ' + room.name);
+
+        radio.addEventListener('change', function() {
+          selectedRoomId = room.id;
+          renderRooms();
+          setStatus('Ready for ' + room.name + '.');
+
+          window.requestAnimationFrame(function() {
+            const selectedInput = roomsList.querySelector(
+              '.room-row.selected .manual-input'
+            );
+
+            if (selectedInput && !selectedInput.disabled) {
+              selectedInput.focus();
+              selectedInput.select();
+            }
+          });
+        });
+
+        controls.appendChild(radio);
+
+        const autoGroup = document.createElement('div');
+        autoGroup.className = 'control-group';
+
+        // The label appears only in the selected room row.
+        if (selected) {
+          const autoLabel = document.createElement('div');
+          autoLabel.className = 'control-label';
+          autoLabel.textContent = 'Auto code';
+          autoGroup.appendChild(autoLabel);
+        }
+
+        const autoButton = document.createElement('button');
+        autoButton.type = 'button';
+        autoButton.className = 'action-button';
+        autoButton.textContent = 'Auto';
+        autoButton.disabled =
+          !selected ||
+          busy ||
+          !prepared;
+
+        autoButton.addEventListener('click', function(event) {
+          event.stopPropagation();
+          handleAutoCode(room.id);
+        });
+
+        autoGroup.appendChild(autoButton);
+
+        const manualGroup = document.createElement('div');
+        manualGroup.className = 'control-group';
+
+        // The label appears only in the selected room row.
+        if (selected) {
+          const manualLabel = document.createElement('div');
+          manualLabel.className = 'control-label';
+          manualLabel.textContent = 'Manual Code';
+          manualGroup.appendChild(manualLabel);
+        }
+
+        const manualEntryRow = document.createElement('div');
+        manualEntryRow.className = 'manual-entry-row';
+
+        const manualInput = document.createElement('input');
+        manualInput.type = 'text';
+        manualInput.className = 'manual-input';
+        manualInput.inputMode = 'numeric';
+        manualInput.autocomplete = 'off';
+        manualInput.maxLength = 4;
+        manualInput.placeholder = '0000';
+        manualInput.value = manualInputs[room.id] || '';
+        manualInput.disabled =
+          !selected ||
+          busy;
+        manualInput.setAttribute(
+          'aria-label',
+          'Manual four-digit code for ' + room.name
+        );
+
+        const okButton = document.createElement('button');
+        okButton.type = 'button';
+        okButton.className = 'action-button';
+        okButton.textContent = 'OK';
+        okButton.disabled =
+          !selected ||
+          busy ||
+          manualInput.value.length !== 4;
+
+        manualInput.addEventListener('input', function() {
+          const digits = manualInput.value
+            .replace(/\D/g, '')
+            .slice(0, 4);
+
+          manualInput.value = digits;
+          manualInputs[room.id] = digits;
+          okButton.disabled =
+            !selected ||
+            busy ||
+            digits.length !== 4;
+        });
+
+        manualInput.addEventListener('keydown', function(event) {
+          if (
+            event.key === 'Enter' &&
+            !okButton.disabled
+          ) {
+            event.preventDefault();
+            handleManualCode(room.id);
+          }
+        });
+
+        okButton.addEventListener('click', function(event) {
+          event.stopPropagation();
+          handleManualCode(room.id);
+        });
+
+        manualEntryRow.append(manualInput, okButton);
+        manualGroup.appendChild(manualEntryRow);
+        controls.append(autoGroup, manualGroup);
+
+        const actual = document.createElement('div');
+        actual.className =
+          'code-cell actual-code' +
+          (room.changed ? ' changed' : '') +
+          (!room.actualCode ? ' empty-code' : '');
+        actual.dataset.label = 'Actual code';
+
+        const actualValue = document.createElement('span');
+        actualValue.className = 'actual-code-value';
+        actualValue.textContent = codeText(room.actualCode);
+
+        const copyButton = document.createElement('button');
+        copyButton.type = 'button';
+        copyButton.className =
+          'mobile-copy-button' +
+          (copiedRoomId === room.id ? ' copied' : '');
+        copyButton.textContent =
+          copiedRoomId === room.id
+            ? 'Copied'
+            : 'Copy';
+        copyButton.disabled = !room.actualCode;
+        copyButton.setAttribute(
+          'aria-label',
+          'Copy actual code for ' + room.name
+        );
+
+        copyButton.addEventListener('click', async function(event) {
+          event.stopPropagation();
+
+          if (!room.actualCode) {
+            return;
+          }
+
+          const copied = await copyImmediately(room.actualCode);
+
+          if (copied) {
+            copiedRoomId = room.id;
+
+            roomsList
+              .querySelectorAll('.mobile-copy-button')
+              .forEach(function(button) {
+                button.classList.remove('copied');
+                button.textContent = 'Copy';
+              });
+
+            copyButton.classList.add('copied');
+            copyButton.textContent = 'Copied';
+
+            setStatus(room.name + ' code copied.', 'success');
+          } else {
+            setStatus(
+              'Clipboard access was blocked.',
+              'error'
+            );
+          }
+        });
+
+        actual.append(actualValue, copyButton);
+
+        const count = document.createElement('div');
+        count.className = 'change-count';
+        count.textContent = countText(room.todayChangedCount);
+        count.dataset.label = 'Today changed';
+
+        row.append(
+          name,
+          previousDate,
+          previous,
+          controls,
+          actual,
+          count
+        );
+
+        roomsList.appendChild(row);
+      });
+    }
+
+    function loadInitialState() {
+      busy = true;
+      renderRooms();
+      setStatus('Loading room data…');
+
+      google.script.run
+        .withSuccessHandler(function(state) {
+          rooms = state.rooms || [];
+          prepared = state.next;
+          todayKey = state.todayKey || '';
+          todayDisplay = state.todayDisplay || '';
+          busy = false;
+          renderRooms();
+          setStatus('Select one room.');
+        })
+        .withFailureHandler(showError)
+        .getInitialState();
+    }
+
+    async function copyImmediately(text) {
+      try {
+        if (navigator.clipboard && navigator.clipboard.writeText) {
+          await navigator.clipboard.writeText(text);
+          return true;
+        }
+      } catch (error) {
+        console.log('Clipboard API unavailable:', error);
+      }
+
+      try {
+        copyBuffer.value = text;
+        copyBuffer.focus();
+        copyBuffer.select();
+        copyBuffer.setSelectionRange(0, text.length);
+
+        const copied = document.execCommand('copy');
+        window.getSelection()?.removeAllRanges();
+        return copied;
+      } catch (error) {
+        console.log('Clipboard fallback unavailable:', error);
+        return false;
+      }
+    }
+
+    function applyOptimisticAssignment(roomId, code) {
+      const room = rooms.find(function(item) {
+        return item.id === roomId;
+      });
+
+      if (!room) {
+        return;
+      }
+
+      room.previousCode = room.actualCode;
+      room.previousCodeDate = room.actualCodeDate;
+      room.previousCodeDateDisplay =
+        room.actualCodeDateDisplay || '';
+
+      room.actualCode = code;
+      room.actualCodeDate = todayKey;
+      room.actualCodeDateDisplay = todayDisplay;
+      room.todayChangedCount =
+        (Number(room.todayChangedCount) || 0) + 1;
+      room.changed =
+        room.actualCode !== '' &&
+        room.actualCode !== room.previousCode;
+    }
+
+    async function handleAutoCode(roomId) {
+      if (
+        busy ||
+        !prepared ||
+        selectedRoomId !== roomId
+      ) {
+        return;
+      }
+
+      const room = selectedRoom();
+
+      if (!room) {
+        return;
+      }
+
+      busy = true;
+      const selectedPreview = prepared;
+      const roomSnapshot = cloneRooms(rooms);
+      prepared = null;
+
+      generatedCode.textContent = selectedPreview.code;
+      applyOptimisticAssignment(roomId, selectedPreview.code);
+      renderRooms();
+      setStatus('Saving ' + room.name + ' automatically…');
+
+      const copied = await copyImmediately(selectedPreview.code);
+
+      google.script.run
+        .withSuccessHandler(function(result) {
+          busy = false;
+          todayKey = result.todayKey || todayKey;
+          todayDisplay = result.todayDisplay || todayDisplay;
+
+          if (!result.ok && result.conflict) {
+            rooms = roomSnapshot;
+            prepared = result.next;
+            generatedCode.textContent = '----';
+            renderRooms();
+            setStatus(
+              'The sequence changed in another session. Click Auto again.',
+              'error'
+            );
+            return;
+          }
+
+          mergeRoomState(result.assignment);
+          prepared = result.next;
+          generatedCode.textContent =
+            result.assignment.actualCode;
+
+          renderRooms();
+
+          setStatus(
+            result.assignment.name +
+              ' updated - automatic code',
+            'success'
+          );
+        })
+        .withFailureHandler(function(error) {
+          busy = false;
+          rooms = roomSnapshot;
+          prepared = selectedPreview;
+          generatedCode.textContent = '----';
+          renderRooms();
+          showError(error);
+        })
+        .assignPreparedCode(roomId, selectedPreview.index);
+    }
+
+    function handleManualCode(roomId) {
+      if (
+        busy ||
+        selectedRoomId !== roomId
+      ) {
+        return;
+      }
+
+      const code = manualInputs[roomId] || '';
+
+      if (!/^\d{4}$/.test(code)) {
+        return;
+      }
+
+      if (isCodeAlreadyUsed(code)) {
+        showAppAlert('The code already used! in the last 30 days!');
+        setStatus('The code already used! in the last 30 days!', 'error');
+        return;
+      }
+
+      const room = selectedRoom();
+
+      if (!room) {
+        return;
+      }
+
+      busy = true;
+      const roomSnapshot = cloneRooms(rooms);
+
+      generatedCode.textContent = code;
+      applyOptimisticAssignment(roomId, code);
+      renderRooms();
+      setStatus('Saving manual code for ' + room.name + '…');
+
+      google.script.run
+        .withSuccessHandler(async function(result) {
+          busy = false;
+          todayKey = result.todayKey || todayKey;
+          todayDisplay = result.todayDisplay || todayDisplay;
+          prepared = result.next || prepared;
+
+          if (!result.ok && result.duplicate) {
+            rooms = roomSnapshot;
+            generatedCode.textContent = '----';
+            renderRooms();
+            showAppAlert('The code already used! in the last 30 days!');
+            setStatus('The code already used! in the last 30 days!', 'error');
+            return;
+          }
+
+          mergeRoomState(result.assignment);
+          manualInputs[roomId] = '';
+          generatedCode.textContent =
+            result.assignment.actualCode;
+
+          renderRooms();
+
+          const copied = await copyImmediately(
+            result.assignment.actualCode
+          );
+
+          setStatus(
+            result.assignment.name +
+              ' updated - manual code',
+            'success'
+          );
+        })
+        .withFailureHandler(function(error) {
+          busy = false;
+          rooms = roomSnapshot;
+          generatedCode.textContent = '----';
+          renderRooms();
+          showError(error);
+        })
+        .assignManualCode(roomId, code);
+    }
+
+    function showError(error) {
+      busy = false;
+      renderRooms();
+
+      const message =
+        error && error.message
+          ? error.message
+          : String(error || 'Unexpected error.');
+
+      setStatus(message, 'error');
+    }
+
+    const mobileDisplayQuery = window.matchMedia(
+      '(max-width: 760px), (pointer: coarse)'
+    );
+
+    function updateDisplayMode() {
+      document.documentElement.classList.toggle(
+        'mobile-display',
+        mobileDisplayQuery.matches
+      );
+    }
+
+    updateDisplayMode();
+
+    if (mobileDisplayQuery.addEventListener) {
+      mobileDisplayQuery.addEventListener(
+        'change',
+        updateDisplayMode
+      );
+    } else {
+      mobileDisplayQuery.addListener(updateDisplayMode);
+    }
+
+    window.addEventListener('orientationchange', function() {
+      window.setTimeout(updateDisplayMode, 100);
+    });
+
+    loadInitialState();
+  </script>
+</body>
+</html>
