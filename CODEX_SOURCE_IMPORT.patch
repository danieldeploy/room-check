+      if (!code || !timestamp) {
+        return;
+      }
+
+      const numericCode = Number(code);
+
+      if (
+        !latest[numericCode] ||
+        timestamp.getTime() >
+          latest[numericCode].getTime()
+      ) {
+        latest[numericCode] = timestamp;
+      }
+    });
+  });
