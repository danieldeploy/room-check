+  room.previousCodeDate = previousCodeDate;
+  room.actualCode = actualCode;
+  room.actualCodeDate = actualCodeDate;
+  room.stateDate = today;
+  room.todayChangedCount = todayChangedCount;
+  room.updatedAt = now;
