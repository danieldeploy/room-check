+      return {
+        roomId: room.id,
+        roomName: room.name,
+        field: 'Previous code'
+      };
+    }
+
+    if (room.actualCode === candidateCode) {
+      return {
+        roomId: room.id,
+        roomName: room.name,
+        field: 'Actual code'
+      };
+    }
+  }
